# ============================================================
# FundFlow AI — Environment Configuration Template
# ============================================================
# HOW TO USE:
#   1. Copy this file and rename the copy to `.env`
#      (command: cp env.example .env  OR  copy env.example .env)
#   2. Replace every placeholder value with your real credentials.
#   3. NEVER commit the `.env` file to version control.
#      Add `.env` to your .gitignore before your first push.
#
# This template file (env.example) is safe to commit — it
# contains no real secrets and only describes the required keys.
# ============================================================

# ----------------------------------------------------------
# IBM Cloud Credentials
# ----------------------------------------------------------

# Your IBM Cloud API Key (IAM key from cloud.ibm.com)
IBM_API_KEY=your_ibm_api_key_here

# IBM Granite inference endpoint URL (from your IBM Cloud service)
IBM_GRANITE_URL=your_ibm_granite_url_here

# IBM Granite model identifier (e.g. ibm/granite-4-h-small)
IBM_GRANITE_MODEL_ID=your_ibm_granite_model_id_here

# IBM watsonx.ai Project ID (UUID v4 — REQUIRED for API calls)
# How to find: IBM Cloud → watsonx.ai → Open your project → Manage tab → copy Project ID
IBM_PROJECT_ID=your_project_id_uuid_here

# ----------------------------------------------------------
# Flask Application Settings
# ----------------------------------------------------------

# Host to bind the Flask development server
FLASK_HOST=127.0.0.1

# Port for the Flask development server
FLASK_PORT=5000

# Environment mode: "development" (debug on) | "production"
FLASK_ENV=development
